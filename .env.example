# Copy to .env (worker, docker compose) and apps/web/.env.local (Next.js).

# --- Supabase ---
# Local: run `npx supabase start` and copy the printed values.
# From inside Docker, use http://host.docker.internal:54321 instead of 127.0.0.1.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=http://127.0.0.1:54321
# Server-only (service role). Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- AI provider: groq | gemini | ollama ---
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Model IDs change often; pick current ones from the provider's model list.
AI_TEXT_MODEL=
AI_VISION_MODEL=

# --- Abuse protection ---
# Any long random string; used to hash client IPs for rate limiting.
RATE_LIMIT_SALT=

# --- Worker ---
PORT=7860
WORKER_POLL_INTERVAL_MS=2000
